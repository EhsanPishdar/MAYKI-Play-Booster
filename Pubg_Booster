#!/bin/bash
# MAYKI PLAY BOOSTER — PUBG PRO BOOSTER (Non-root, Optimized)
# Version: 1.3
# Creator: Ehsan

CHANNEL_LINK="https://t.me/MAYKI_1_SHOP_PUBG"

# Colors & Styles
GREEN="\e[1;32m"
DARK_GREEN="\e[0;32m"
YELLOW="\e[1;33m"
RED="\e[1;31m"
NC="\e[0m"

pause() { sleep ${1:-0.2}; }
info() { echo -e "${GREEN}[INFO]${NC} $1"; }

show_header() {
  clear
  echo -e "${DARK_GREEN}================================================${NC}"
  echo -e "${GREEN}      ⚡ M A Y K I   P L A Y   B O O S T E R  ⚡${NC}"
  echo -e "${DARK_GREEN}================================================${NC}"
  echo -e "${YELLOW}  Creator:${NC} Ehsan  |  ${YELLOW}Version:${NC} 1.3 (Pro UI)"
  echo -e "${DARK_GREEN}------------------------------------------------${NC}"
  echo
}

select_version() {
  show_header
  echo -e "${YELLOW}Select PUBG Version:${NC}"
  echo -e "${GREEN}1)${NC} Global (com.tencent.ig)"
  echo -e "${GREEN}2)${NC} Korea (com.pubg.krmobile)"
  echo -e "${GREEN}3)${NC} Vietnam (com.vng.pubgmobile)"
  echo
  read -p "Select [1-3, default 1]> " ver_sel
  case "$ver_sel" in
    2) GAME_PACKAGE="com.pubg.krmobile";;
    3) GAME_PACKAGE="com.vng.pubgmobile";;
    *) GAME_PACKAGE="com.tencent.ig";;
  esac
}

military_boost() {
  select_version
  show_header
  info "Activating Mayki Boost for $GAME_PACKAGE..."
  pause 0.3

  info "Step 1: Soft RAM trim..."
  am send-trim-memory com.termux 80 >/dev/null 2>&1 || true
  pause 0.2

  info "Step 2: Closing background apps..."
  for app in com.android.chrome com.facebook.katana com.youtube.android com.instagram.android; do
    am force-stop $app >/dev/null 2>&1 || true
  done
  pause 0.2

  info "Step 3: Deep Cache & Junk Cleaning..."
  rm -rf /sdcard/Android/data/${GAME_PACKAGE}/cache/* 2>/dev/null || true
  rm -rf /sdcard/Android/data/${GAME_PACKAGE}/files/UE4Game/ShadowTrackerExtra/ShadowTrackerExtra/Saved/Logs/* 2>/dev/null || true
  rm -rf /sdcard/Android/data/${GAME_PACKAGE}/files/UE4Game/ShadowTrackerExtra/ShadowTrackerExtra/Saved/Crashes/* 2>/dev/null || true
  rm -rf /sdcard/Android/data/${GAME_PACKAGE}/files/Temp/* 2>/dev/null || true
  pause 0.2

  info "Step 4: Applying 120FPS & Performance Config..."
  CONFIG_DIR="/sdcard/Android/data/${GAME_PACKAGE}/files/UE4Game/ShadowTrackerExtra/ShadowTrackerExtra/Saved/Config/Android"
  mkdir -p "$CONFIG_DIR" 2>/dev/null || true
  
  echo "[/Script/Engine.RendererSettings]" > "$CONFIG_DIR/GameUserSettings.ini" 2>/dev/null || true
  echo "bUse120FPS=True" >> "$CONFIG_DIR/GameUserSettings.ini" 2>/dev/null || true
  echo "bSmoothFrameRate=True" >> "$CONFIG_DIR/GameUserSettings.ini" 2>/dev/null || true
  pause 0.2

  info "Mayki Boost Applied Successfully!"
  pause 0.5
}

network_test() {
  show_header
  info "Network / Internet Booster"
  echo -e "${GREEN}Checking ping to 1.1.1.1${NC}"
  ping -c3 1.1.1.1
  pause 0.5
}

open_telegram() {
  show_header
  info "Opening Telegram Channel..."
  am start -a android.intent.action.VIEW -d "$CHANNEL_LINK" >/dev/null 2>&1 || true
  pause 0.5
}

menu() {
  while true; do
    show_header
    echo -e "${GREEN} [1]${NC} 🚀 Mayki Boost (PUBG Optimizer)"
    echo -e "${GREEN} [2]${NC} 🌐 Network Ping Test / Internet Booster"
    echo -e "${GREEN} [3]${NC} 📢 Open Official Telegram Channel"
    echo -e "${GREEN} [4]${NC} ❌ Exit Script"
    echo
    read -p " Select option [1-4]: " sel
    case "$sel" in
      1) military_boost;;
      2) network_test;;
      3) open_telegram;;
      4) clear; echo -e "${RED}[!] Exiting... Good luck in the match!${NC}"; sleep 0.4; exit 0;;
      *) echo -e "${RED}[X] Invalid option, try again.${NC}"; sleep 0.6;;
    esac
    read -p "Press Enter to continue..."
  done
}

# Start
menu
